---
import SiteHeader from "./SiteHeader.astro";
import { landingAssets } from "../data/landingAssets";
import { demoOptions, faqItems, type LandingPageContent } from "../data/landingPages";
import "../styles/global.css";

interface Props {
  page: LandingPageContent;
}

const { page } = Astro.props;
const demoEntries = Object.values(demoOptions);
const isHome = page.route === "home";
const heroAsset = landingAssets[page.heroAsset];
const homeHeroAsset = landingAssets.homeHero;
const petHeroAsset = landingAssets.petHero;
const narrativeStages = page.narrativeStages ?? [];
const sourceChips =
  page.route === "home"
    ? ["Selected cameras", "Home Assistant", "Zigbee", "IR", "Local timeline"]
    : page.route === "package"
      ? ["Front door camera", "Package timeline", "Useful alert", "Local-first direction"]
      : ["Indoor camera", "Pet highlights", "Home timeline", "Clips worth keeping"];
const headlineParts = page.headline
  .split(".")
  .map((part) => part.trim())
  .filter(Boolean)
  .map((part) => `${part}.`);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.metaTitle,
  description: page.metaDescription,
  url: `https://harbornavi.com${page.path}`
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.metaTitle} | HarborNavi</title>
    <meta name="description" content={page.metaDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`https://harbornavi.com${page.path}`} />
    <meta property="og:title" content={`${page.metaTitle} | HarborNavi`} />
    <meta property="og:description" content={page.metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={heroAsset.url} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body data-route={page.route}>
    <SiteHeader activeRoute={page.route} />
    <main>
      {isHome ? (
        <>
          <section class="slogan-hero section-shell" aria-labelledby="slogan-title">
            <div class="slogan-visuals" aria-hidden="true">
              <img
                class="slogan-visual slogan-visual-top"
                src={homeHeroAsset.url}
                alt=""
                width={homeHeroAsset.width}
                height={homeHeroAsset.height}
              />
              <img
                class="slogan-visual slogan-visual-bottom"
                src={petHeroAsset.url}
                alt=""
                width={petHeroAsset.width}
                height={petHeroAsset.height}
              />
            </div>
            <div class="slogan-lockup">
              <p class="eyebrow">{page.eyebrow}</p>
              <h1 id="slogan-title" class="slogan-title">
                {headlineParts.map((part) => <span>{part}</span>)}
              </h1>
              <div class="hero-capture" aria-label="Early access waitlist form">
                <div>
                  <h2>Join the early access list.</h2>
                  <p>Leave an email for package context, pet moments, and plain-language device workflows.</p>
                </div>
                <form class="quick-waitlist-form" data-waitlist-form data-form-kind="hero">
                  <label>
                    Email
                    <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
                  </label>
                  <button class="primary-button" type="submit">Join the email list</button>
                  <p class="form-success" data-form-success hidden>
                    Thanks. We will follow up when early access opens.
                  </p>
                </form>
              </div>
            </div>
          </section>

          <section class="slogan-afterword section-shell" aria-label="HarborNavi product direction">
            <div class="slogan-floor">
              <p>{page.supportLine}</p>
              <a class="secondary-link" href="#know-space">Start with space</a>
            </div>
          </section>

          <section class="slogan-breakdown" aria-label="Slogan breakdown">
            {narrativeStages.map((stage) => {
              const stageAsset = landingAssets[stage.imageAsset];
              return (
              <article id={stage.id} class="narrative-stage">
                <div class="section-shell narrative-stage-grid">
                  <div class="stage-lockup">
                    <p class="eyebrow">{stage.eyebrow}</p>
                    <h2>{stage.phrase}</h2>
                  </div>
                  <div class="stage-detail">
                    <div class="stage-copy">
                      <h3>{stage.title}</h3>
                      <p>{stage.problem}</p>
                      <p>{stage.product}</p>
                      <div class="stage-signals" aria-label={`${stage.phrase} signals`}>
                        {stage.signals.map((signal) => <span>{signal}</span>)}
                      </div>
                    </div>
                    <figure class="stage-visual">
                      <img
                        src={stageAsset.url}
                        alt={stageAsset.alt}
                        width={stageAsset.width}
                        height={stageAsset.height}
                        loading="lazy"
                      />
                      <figcaption>Storyboard preview. Product experience may change.</figcaption>
                    </figure>
                  </div>
                </div>
              </article>
              );
            })}
          </section>

          <section class="home-scenarios section-shell" aria-labelledby="home-scenarios-title">
            <div class="section-heading">
              <p class="eyebrow">Choose what matters</p>
              <h2 id="home-scenarios-title">Tell us which home workflow you want first.</h2>
              <p>
                Your interest helps us prioritize package context, pet moments, and plain-language device
                workflows.
              </p>
            </div>
            <div class="use-case-grid">
              {page.useCases.map((useCase) => (
                <article class="use-case-card">
                  {useCase.label && <p class="card-label">{useCase.label}</p>}
                  <h3>{useCase.title}</h3>
                  <p>{useCase.body}</p>
                </article>
              ))}
            </div>
          </section>
        </>
      ) : (
        <>
          <section class="hero section-shell" aria-labelledby="hero-title">
            <div class="hero-copy">
              <p class="eyebrow">{page.eyebrow}</p>
              <h1 id="hero-title" class="hero-title">
                {headlineParts.map((part) => <span>{part}</span>)}
              </h1>
              <p class="hero-body">{page.body}</p>
              <p class="hero-support">{page.supportLine}</p>
              <div class="source-chips" aria-label="HarborNavi source coverage">
                {sourceChips.map((chip) => <span>{chip}</span>)}
              </div>
              <div class="hero-actions">
                <a class="primary-button" href="#waitlist" data-track="waitlist_start">{page.cta}</a>
                <a class="secondary-link" href="#demo">Try the workflow preview</a>
              </div>
            </div>
            <figure class="hero-media">
              <div class="hero-frame">
                <div class="hero-frame-top" aria-hidden="true">
                  <span>Home timeline</span>
                  <span>Selected events</span>
                </div>
                <img
                  src={heroAsset.url}
                  alt={heroAsset.alt}
                  width={heroAsset.width}
                  height={heroAsset.height}
                  loading="eager"
                />
              </div>
              <figcaption>Storyboard preview. Product experience may change.</figcaption>
            </figure>
          </section>

          <section class="proof-strip section-shell" aria-labelledby="proof-title">
            <div class="proof-heading">
              <p class="eyebrow">Why this line matters</p>
              <h2 id="proof-title">Each part maps to a real home problem.</h2>
            </div>
            {page.proofPoints.map((point) => (
              <article>
                <p>{point.label}</p>
                <h2>{point.title}</h2>
                <span>{point.body}</span>
              </article>
            ))}
          </section>

          <section class="use-cases section-shell" aria-labelledby="use-cases-title">
            <div class="section-heading">
              <p class="eyebrow">Real home scenarios</p>
              <h2 id="use-cases-title">Start with scenes people already understand.</h2>
            </div>
            <div class="use-case-grid">
              {page.useCases.map((useCase) => (
                <article class="use-case-card">
                  {useCase.label && <p class="card-label">{useCase.label}</p>}
                  <h3>{useCase.title}</h3>
                  <p>{useCase.body}</p>
                </article>
              ))}
            </div>
          </section>
        </>
      )}

      <section id="demo" class="demo-section section-shell" aria-labelledby="demo-title">
        <div class="section-heading">
          <p class="eyebrow">Workflow preview</p>
          <h2 id="demo-title">Describe what you want your home to do.</h2>
          <p>Choose a scene and see the kind of timeline HarborNavi is designed to create.</p>
        </div>
        <div class="demo-grid">
          <div class="demo-options" role="tablist" aria-label="Demo options">
            {demoEntries.map((demo) => (
              <button
                class:list={["demo-option", { active: demo.key === page.defaultDemo }]}
                type="button"
                role="tab"
                aria-selected={demo.key === page.defaultDemo ? "true" : "false"}
                aria-controls={`demo-panel-${demo.key}`}
                id={`demo-tab-${demo.key}`}
                data-demo-key={demo.key}
              >
                {demo.label}
              </button>
            ))}
          </div>
          <div class="demo-panels">
            {demoEntries.map((demo) => (
              <article
                class:list={["timeline-panel", { active: demo.key === page.defaultDemo }]}
                id={`demo-panel-${demo.key}`}
                role="tabpanel"
                aria-labelledby={`demo-tab-${demo.key}`}
                data-demo-panel={demo.key}
                hidden={demo.key !== page.defaultDemo}
              >
                <ol>
                  {demo.timeline.map((item) => <li>{item}</li>)}
                </ol>
                <a class="primary-button timeline-cta" href="#waitlist" data-track="waitlist_start">{demo.cta}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      {!isHome && (
        <section class="how-section section-shell" aria-labelledby="how-title">
          <div class="section-heading">
            <p class="eyebrow">How it works</p>
            <h2 id="how-title">From household signal to reviewable workflow.</h2>
          </div>
          <div class="steps">
            {page.workflowSteps.map((step, index) => (
              <div class="step">
                <span>{index + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="trust-section section-shell" aria-labelledby="trust-title">
        <div>
          <p class="eyebrow">Private by design</p>
          <h2 id="trust-title">Useful home AI needs clear boundaries.</h2>
        </div>
        <div class="trust-copy">
          <p>
            HarborNavi is being designed around selected household workflows: useful events, moments worth
            keeping, and device actions that stay reviewable.
          </p>
          <p>
            The direction is local-first, authorized cloud fallback only when needed, and no prevention or
            recovery promises.
          </p>
          <ul class="trust-list">
            <li>Camera credentials and device state are designed to stay local by default.</li>
            <li>Cloud fallback should be authorized, redacted, and auditable.</li>
            <li>Device workflows should stay reviewable before sensitive actions run.</li>
          </ul>
        </div>
      </section>

      <section id="waitlist" class="waitlist-section section-shell" aria-labelledby="waitlist-title">
        <div class="form-intro">
          <p class="eyebrow">Early access</p>
          <h2 id="waitlist-title">Join the early access list.</h2>
          <p>
            Tell us which home workflow matters most to you. We will follow up as early access opens.
          </p>
        </div>
        <form class="waitlist-form" data-waitlist-form>
          <label>
            Email
            <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          </label>
          <label>
            Country
            <input name="country" type="text" autocomplete="country-name" placeholder="United States" required />
          </label>
          <label>
            Current camera brand or setup
            <input name="camera_setup" type="text" placeholder="Ring, Nest, Eufy, Wyze, RTSP, none yet" />
          </label>
          <label>
            Main interest
            <select name="main_interest" required>
              <option value="">Choose one</option>
              <option value="package_alerts">Package alerts</option>
              <option value="pet_highlights">Pet highlights</option>
              <option value="both">Both</option>
              <option value="other_home_events">Other home events</option>
            </select>
          </label>
          <fieldset>
            <legend>Beta willingness</legend>
            <label class="radio-row">
              <input type="radio" name="beta_willingness" value="own_footage" />
              Join beta with my own footage
            </label>
            <label class="radio-row">
              <input type="radio" name="beta_willingness" value="updates_only" />
              Updates only
            </label>
            <label class="radio-row">
              <input type="radio" name="beta_willingness" value="curious" />
              Just curious
            </label>
          </fieldset>
          <label>
            What do you wish your home camera could catch for you?
            <textarea name="pain_point" rows="4" placeholder="Tell us the moment you keep missing."></textarea>
          </label>
          <button class="primary-button form-button" type="submit">Join early access</button>
          <p class="form-success" data-form-success hidden>
            Thanks. We will follow up when early access opens.
          </p>
        </form>
      </section>

      <section class="faq-section section-shell" aria-labelledby="faq-title">
        <div class="section-heading">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Plain answers before launch.</h2>
        </div>
        <div class="faq-list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <span>HarborNavi</span>
      <a href="/privacy">Privacy</a>
    </footer>

    <script is:inline>
      window.harborTrack =
        window.harborTrack ||
        function harborTrack(eventName, properties) {
          window.harborEvents = window.harborEvents || [];
          window.harborEvents.push({
            eventName,
            properties: properties || {},
            timestamp: new Date().toISOString()
          });
        };

      const route = document.body.dataset.route || "unknown";
      window.harborTrack("page_view", { route });

      document.querySelectorAll("[data-track]").forEach((element) => {
        element.addEventListener("click", () => {
          window.harborTrack(element.getAttribute("data-track"), { route });
        });
      });

      document.querySelectorAll("[data-demo-key]").forEach((tab) => {
        tab.addEventListener("click", () => {
          const key = tab.getAttribute("data-demo-key");
          document.querySelectorAll("[data-demo-key]").forEach((button) => {
            const isActive = button.getAttribute("data-demo-key") === key;
            button.classList.toggle("active", isActive);
            button.setAttribute("aria-selected", isActive ? "true" : "false");
          });
          document.querySelectorAll("[data-demo-panel]").forEach((panel) => {
            const isActive = panel.getAttribute("data-demo-panel") === key;
            panel.hidden = !isActive;
            panel.classList.toggle("active", isActive);
          });
          const eventName = key === "package" ? "demo_option_package" : key === "pet" ? "demo_option_pet" : "demo_option_unusual";
          window.harborTrack(eventName, { route });
        });
      });

      document.querySelectorAll("[data-waitlist-form]").forEach((form) => {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const data = new FormData(form);
          const betaWillingness = data.get("beta_willingness");
          window.harborTrack("waitlist_submit", {
            route,
            form_kind: form.dataset.formKind || "full",
            has_email: Boolean(data.get("email")),
            main_interest: data.get("main_interest") || "",
            has_camera_setup: Boolean(data.get("camera_setup")),
            beta_willingness: betaWillingness || ""
          });
          if (betaWillingness === "own_footage" || data.get("pain_point")) {
            window.harborTrack("qualified_lead", { route });
          }
          if (betaWillingness === "own_footage") {
            window.harborTrack("beta_interview_request", { route });
          }
          const success = form.querySelector("[data-form-success]");
          if (success) {
            success.hidden = false;
          }
        });
      });
    </script>
  </body>
</html>
