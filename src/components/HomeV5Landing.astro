            <input class="sr-only" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" disabled />
            <button type="submit">View current launch page</button>
          </form>
          <p id="v5-final-error" class="form-error" data-form-error aria-live="polite" hidden>We could not save your email. Please try again.</p>
          <p id="v5-final-note" class="form-note">
            HarborNavi's current launch list is available on the V6 page. <a href="/privacy">Privacy</a>
          </p>
        </section>
      </main>

      <footer>
        <a class="brand" href="#top" aria-label="HarborNavi home"><span class="brand-mark" aria-hidden="true"><img src="/favicon.svg" alt="" width="22" height="22" /></span><span>HarborNavi</span></a>
        <p>The spark that brings your home to life.</p>
      </footer>

      <div class="modal" data-success-modal hidden role="dialog" aria-modal="true" aria-labelledby="v5-success-title" aria-describedby="v5-success-description">
