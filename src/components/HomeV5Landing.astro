---
import RedditPixel from "./RedditPixel.astro";
import "../styles/home-v5.css";
import { campaign } from "../data/campaign";

const discordUrl = "https://discord.gg/tC2bktRWWj";
const surveyUrl = "https://www.surveymonkey.com/r/harbornavi";
const heroImage = "/assets/home-v5-exceptions-hero.png";

const exceptions = [
  {
    time: "7:00 AM",
    kicker: "A slower morning",
    title: "The baby slept in.",
    rule: "Lights on at 7:00",
    reality: "Still asleep",
    image: "/assets/home-v5-sleeping-child-card.png",
    imageAlt: "A child sleeping in bed later than the usual morning routine",
    tone: "lavender"
  },
  {
    time: "3:42 PM",
    kicker: "An early arrival",
    title: "The sitter came early.",
    rule: "Access starts at 4:00",
    reality: "Already at the door",
    image: "/assets/home-v4-return-home-hero.png",
    imageAlt: "A trusted visitor arriving at the front door earlier than expected",
    tone: "teal"
  },
  {
    time: "2:31 PM",
    kicker: "A delivery changed",
    title: "The package left again.",
    rule: "Delivered at 2:14",
    reality: "Removed 17 minutes later",
    image: "/assets/home-v3-alert-that-mattered.png",
    imageAlt: "A porch package event changing from delivered to removed",
    tone: "ink"
  }
];

const contextInputs = [
  ["Selected camera event", "A package leaves the porch"],
  ["Door and presence", "No household member is outside"],
  ["Recent memory", "Delivery confirmed 17 minutes earlier"],
  ["Household permission", "Porch response is pre-authorized"]
];

const contextQuestions = ["What changed?", "Does it matter now?", "Who is involved?", "What is allowed next?"];

const connectionPaths = [
  ["HA", "Home Assistant", "Bring existing entities, scenes, and automations into the same home picture."],
  ["RT", "RTSP / ONVIF", "Use supported local camera paths without rebuilding around one brand."],
  ["SI", "Selected integrations", "Add device state and actions from services you already rely on."],
  ["ZB", "Zigbee", "Designed for direct support of common sensors, switches, and small devices."],
  ["IR", "IR", "Designed to reach TVs and climate devices that still work best by remote."]
];

const hardwareValues = [
  ["Local intelligence", "A dedicated K3-class compute design keeps everyday understanding and model work close to the home."],
  ["Local memory", "A 16GB / 128GB base design, with two M.2 slots for longer private retention."],
  ["Device connections", "Dual 2.5GbE, HDMI, Home Assistant, Zigbee, IR, and selected camera paths."],
  ["Physical trust", "Fingerprint confirmation and an embedded secure element for sensitive setup changes."]
];

const comparisonProducts = [
  { name: "Camera AI", note: "Reolink, Tapo, eufy" },
  { name: "Cloud home AI", note: "Google Home, Alexa+ + Ring" },
  { name: "Local automation stacks", note: "Home Assistant + Frigate, Homey Pro" },
  { name: "Professional whole-home", note: "Josh.ai, Control4" },
  { name: "HarborNavi", note: "The whole-home picture", featured: true }
];

const comparisonRows = [
  ["Built around", "Video and security events", "Conversation, summaries, and control inside an account ecosystem", "Devices, entities, rules, and owner-built automations", "Dealer-designed whole-home control", "Selected home signals, memory, permissions, and actions in one household picture"],
  ["Who pieces it together", "The camera vendor's event history", "The vendor cloud and supported services", "The owner or integrator", "The dealer or integrator", "HarborNavi's local system is designed to keep the situation together"],
  ["When the routine changes", "Detect, search, or summarize video", "AI behavior inside supported services", "The owner adds conditions, helpers, and exceptions", "The dealer updates scenes and policies", "Clarify, wait, notify, or act from the shared picture"],
  ["Memory and follow-up", "Footage and event history", "Account and service memory", "Possible with owner-built components", "System state and configured scenes", "Local household memory across events and conversations"],
  ["From understanding to action", "Alerts and vendor-specific responses", "Voice and actions inside supported ecosystems", "Broad actions through user-built automations", "Broad dealer-configured actions", "Conversation, clarification, permission, then coordinated action"],
  ["Setup and maintenance", "Vendor app", "Consumer account and cloud setup", "DIY or self-managed stack", "Professional installation", "Designed for self install with supported paths made clear"],
  ["Data path and subscription", "Varies by vendor and model", "Advanced features and plans vary", "Local core is possible; add-ons vary", "Vendor, dealer, and service terms vary", "Core local features without a required subscription"]
];

const comparisonSources = [
  { label: "Reolink", href: "https://reolink.com/blog/reolink-new-products-at-ces/" },
  { label: "Tapo", href: "https://www.tp-link.com/us/home-networking/smart-hub/tapo-h500/" },
  { label: "eufy", href: "https://www.eufy.com/products/t80301d1" },
  { label: "Google Home", href: "https://store.google.com/us/product/google_home_speaker?hl=en_US" },
  { label: "Alexa+", href: "https://www.aboutamazon.com/news/devices/amazon-new-echo-devices-alexa-plus" },
  { label: "Home Assistant", href: "https://www.home-assistant.io/blog/2025/09/11/ai-in-home-assistant/" },
  { label: "Frigate", href: "https://frigate.video/" },
  { label: "Homey", href: "https://homey.app/en-us/homey-pro/" },
  { label: "Josh.ai", href: "https://www.josh.ai/core/" },
  { label: "Control4", href: "https://www.control4.com/solutions/voice-control" }
];

const faqItems = [
  ["Is HarborNavi another camera recorder?", "A camera is one possible source. HarborNavi is designed around the situation that selected camera events, sensors, device state, recent memory, and household permissions describe together."],
  ["Does it replace Home Assistant?", "Home Assistant remains a strong device and automation layer. HarborNavi adds a shared household picture, memory, clarification, and a simpler path from everyday language to a coordinated workflow."],
  ["Will it work with every device?", "No. HarborNavi starts with supported paths such as Home Assistant, RTSP / ONVIF cameras, selected integrations, Zigbee, and IR. A clear device list will be published before orders open."],
  ["When is fingerprint confirmation used?", "It is for sensitive setup changes such as adding a member, expanding permissions, or pairing a device. Ordinary questions and routines should not require a fingerprint every time."],
  ["Does it require cloud AI?", "Core home memory, policy, and device workflows are designed to run locally. External models remain optional and follow a filtered outbound path when enabled."]
];

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  name: "HarborNavi",
  category: "Local home intelligence",
  slogan: "The spark that brings your home to life.",
  description: "HarborNavi keeps selected home signals, memory, permissions, and actions in one private picture of the day, so the home can explain what changed and help with what happens next.",
  url: "https://harbornavi.com/home-v5",
  image: `https://harbornavi.com${heroImage}`,
  brand: {
    "@type": "Brand",
    name: "HarborNavi"
  }
});
---

<!doctype html>
<html lang="en">
  <head>
    <RedditPixel />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>HarborNavi - At home, exceptions are the routine.</title>
    <meta name="description" content="HarborNavi keeps selected home signals, memory, permissions, and actions in one private picture of the day, so the home can explain what changed and help with what happens next." />
    <link rel="canonical" href="https://harbornavi.com/home-v5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="HarborNavi - At home, exceptions are the routine." />
    <meta property="og:description" content="Local intelligence that keeps the home's changing situation together." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://harbornavi.com/home-v5" />
    <meta property="og:image" content={`https://harbornavi.com${heroImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HarborNavi - At home, exceptions are the routine." />
    <meta name="twitter:description" content="Local intelligence that keeps the home's changing situation together." />
    <meta name="twitter:image" content={`https://harbornavi.com${heroImage}`} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body class="home-v5-page" data-route="home-v5">
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="HarborNavi home">
          <span class="brand-mark" aria-hidden="true"><img src="/favicon.svg" alt="" width="22" height="22" /></span>
          <span>HarborNavi</span>
        </a>
        <nav aria-label="Page sections">
