---
import {
  ArrowRight,
  Camera,
  CircleUserRound,
  Cloud,
  Fingerprint,
  HousePlug,
  Inbox,
  LockKeyhole,
  Menu,
  Microscope,
  ShieldCheck,
  Target,
  Workflow,
  X
} from "@lucide/astro";
import EnglishFormValidation from "./EnglishFormValidation.astro";
import GoogleTagManager from "./GoogleTagManager.astro";
import MarketingConsent from "./MarketingConsent.astro";
import MetaPixel from "./MetaPixel.astro";
import SiteHeaderMenu from "./SiteHeaderMenu.astro";
import SiteMediaLoader from "./SiteMediaLoader.astro";
import { pilotRewardAdvertisingCopy } from "../data/pilotProgram";
import "../styles/site-header-v7.css";
import "../styles/home-v7.css";
import "../styles/home-v9.css";

interface Props {
  version?: "v8" | "v9";
}

const { version = "v8" } = Astro.props;
const isV9 = version === "v9";
const route = isV9 ? "home-v9" : "home-v8";
const pageUrl = isV9 ? "https://harbornavi.com" : "https://harbornavi.com/home-v8";

const discordUrl = "https://discord.gg/tC2bktRWWj";
const surveyUrl = "https://www.surveymonkey.com/r/harbornavi";
const gtmContainerId = import.meta.env.PUBLIC_GOOGLE_TAG_MANAGER_ID?.trim() || "GTM-MXJJ9BXG";
const marketingConsentEnabled = /^GTM-[A-Z0-9]+$/.test(gtmContainerId);
const heroImage = "/assets/home-v7-v8-memory-hero-id.webp";
const heroSocialImage = "/assets/home-v7-v8-memory-hero-id.png";
const heroCarouselSlides = [
  {
    url: "/assets/home-v7-v8-pilot-families-id.webp",
    width: 1802,
    height: 873,
    alt: "A family trying HarborNavi together during an early pilot experience.",
    eyebrow: "HarborNavi Pilot Program",
    title: "Join the First 5 Pilot Families",
    description: `Be first to live with HarborNavi's local household intelligence. Two weeks at home. Yours to keep. ${pilotRewardAdvertisingCopy}`,
    cta: "Join the pilot →",
    highlight: true,
    href: "/pilot-families"
  },
  {
    url: "/assets/home-v7-v8-memory-hero-id.webp",
    width: 1536,
    height: 1024,
    alt: "A family at home while HarborNavi connects household context locally.",
    eyebrow: "A mind for the household",
    title: "Your home, finally fluent."
  },
  {
    url: "/assets/home-v7-v8-movie-night-id.webp",
    width: 1536,
    height: 1024,
    alt: "A movie night coordinated by HarborNavi inside the home.",
    eyebrow: "Private by design",
    title: "Your data, finally home."
  }
];

const intelligenceLayers = [
  {
    index: "01",
    label: "Home signals",
    title: "Understand",
    body: "Selected events, device changes, and requests become one local picture of what is happening at home.",
    detail: "A situation, not another stream of isolated alerts."
  },
  {
    index: "02",
    label: "Home Agent",
    title: "Orchestrate",
    body: "Navi connects context across time, asks when something is unclear, and prepares the next useful step.",
    detail: "Quiet coordination without a new rule for every change."
  },
  {
    index: "03",
    label: "Supported devices",
    title: "Respond",
    body: "Everyday words become temporary plans across supported devices, with permissions for sensitive changes.",
    detail: "Actions stay clear, reviewable, and under your control."
  }
];

const connectionPaths = [
  ["HA", "Home Assistant", "Use supported entities, scenes, and automations you already have."],
  ["RT", "RTSP / ONVIF", "Bring selected local camera events into household context."],
  ["SI", "Selected integrations", "Connect useful device state and actions."],
  ["ZB", "Planned Zigbee", "Support common sensors, switches, and small devices."],
  ["IR", "Planned IR", "Connect TVs and climate devices that still use a remote."]
];

const hardwareValues = [
  ["Household context", "Planned 128GB eMMC plus two M.2 slots give selected events, clips, and home history a local place to live."],
  ["Local intelligence", "Dedicated K3-class compute gives understanding and home workflows a stable place to run."],
  ["Device links", "Dual 2.5GbE, HDMI, Home Assistant, selected cameras, planned Zigbee, and IR."],
  ["Hardware trust", "Fingerprint confirmation for sensitive changes, with Match-on-Chip biometric comparison and an eSE chip protecting device identity and encryption keys."]
];

const comparisonProducts = [
  { name: "HarborNavi", note: "Private household intelligence", featured: true },
  { name: "Camera AI", note: "Reolink, Tapo, eufy" },
  { name: "Cloud home AI", note: "Google Home, Alexa+ + Ring" },
  { name: "Local automation stacks", note: "Home Assistant + Frigate, Homey Pro" },
  { name: "Professional whole-home", note: "Josh.ai, Control4" }
];

const comparisonRows = [
  ["Built around", "Understanding home context, remembering what matters, and coordinating allowed actions", "Video and security events", "Conversation, summaries, and control inside an account ecosystem", "Devices, entities, rules, and owner-built automations", "Dealer-designed whole-home control"],
  ["Who pieces it together", "HarborNavi keeps the household context together locally", "The camera vendor's event history", "The vendor cloud and supported services", "The owner or integrator", "The dealer or integrator"],
  ["When the routine changes", "Clarify, wait, notify, or act from local household context", "Detect, search, or summarize video", "AI behavior inside supported services", "The owner adds conditions, helpers, and exceptions", "The dealer updates scenes and policies"],
  ["Context and follow-up", "Local household context across events, devices, and conversations", "Footage and event history", "Account and service memory", "Possible with owner-built components", "System state and configured scenes"],
  ["From understanding to action", "Conversation, clarification, permission, then coordinated action", "Alerts and vendor-specific responses", "Voice and actions inside supported ecosystems", "Broad actions through user-built automations", "Broad dealer-configured actions"],
  ["Setup and maintenance", "Designed for self-install with supported paths made clear", "Vendor app", "Consumer account and cloud setup", "DIY or self-managed stack", "Professional installation"],
  ["Data path and subscription", "Core local features without a required subscription", "Varies by vendor and model", "Advanced features and plans vary", "Local core is possible; add-ons vary", "Vendor, dealer, and service terms vary"]
];

const comparisonSources = [
  { label: "Reolink", href: "https://reolink.com/blog/reolink-new-products-at-ces/" },
  { label: "Tapo", href: "https://www.tp-link.com/us/home-networking/smart-hub/tapo-h500/" },
  { label: "eufy", href: "https://www.eufy.com/products/t80301d1" },
  { label: "Google Home", href: "https://store.google.com/us/product/google_home_speaker?hl=en_US" },
  { label: "Alexa+", href: "https://www.aboutamazon.com/news/devices/amazon-new-echo-devices-alexa-plus" },
  { label: "Home Assistant", href: "https://www.home-assistant.io/blog/2025/09/11/ai-in-home-assistant/" },
  { label: "Frigate", href: "https://frigate.video/" },
  { label: "Homey", href: "https://homey.app/en-us/homey-pro/" },
  { label: "Josh.ai", href: "https://www.josh.ai/core/" },
  { label: "Control4", href: "https://www.control4.com/solutions/voice-control" }
];

const faqItems = [
  ["Is HarborNavi just a memory box?", "No. Memory gives HarborNavi useful context. Its job is to understand what is happening, coordinate supported devices, and respond in plain words."],
  ["Is it another voice assistant?", "No. HarborNavi is local-first household intelligence, not a cloud voice layer. It connects selected home signals, devices, permissions, and conversations in one place at home."],
  ["Is HarborNavi a NAS?", "It uses local storage for selected photos, clips, events, and home history, but it is built for household intelligence rather than general file-server work."],
  ["Is it another camera recorder?", "Cameras are one source. HarborNavi connects selected moments with sensors, device state, and household permissions."],
  ["Does it replace Home Assistant?", "No. Home Assistant remains the device layer; HarborNavi adds local context, conversation, and simpler temporary plans."],
  ["Will it work with every device?", "No. We start with supported Home Assistant paths, selected RTSP / ONVIF cameras, and planned Zigbee and IR."],
  ["When is fingerprint confirmation used?", "HarborNavi can require a successful match at the box before adding a member, expanding permissions, pairing a device, or changing who can access private household context."],
  ["How does the fingerprint check work?", "The fingerprint is checked inside the fingerprint module. HarborNavi receives the match decision and applies it only to the sensitive change being requested."],
  ["What does the security chip protect?", "The eSE chip keeps device identity, trusted credentials, and encryption keys separate from the main system. The eSE chip and its COS have achieved SOGIS CC EAL5+ certification; that certification applies to the selected security components, not HarborNavi as a complete product."],
  ["Does it require cloud AI?", "Core household context, permissions, and device workflows stay local. External models are optional, and sensitive context can be reviewed before a request leaves home."],
  ["What is the difference between the waitlist and the Pilot Program?", "The waitlist is the quickest way to receive launch news and early-bird pricing updates. The Pilot Program is a separate application for a limited group of families to test HarborNavi at home for two weeks and share structured feedback. Joining the waitlist does not submit a Pilot Program application."]
];

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  name: "HarborNavi",
  category: "Local-first household intelligence",
  slogan: "A mind for the household. Finally at home.",
  description: "HarborNavi is local-first AI that understands household context, coordinates supported devices, remembers what matters, and keeps private data at home.",
  url: pageUrl,
  image: `https://harbornavi.com${heroSocialImage}`,
  brand: {
    "@type": "Brand",
    name: "HarborNavi"
  }
});
---

<!doctype html>
<html lang="en">
  <head>
    <EnglishFormValidation />
    <GoogleTagManager />
    <MetaPixel />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <title>HarborNavi - A mind for the household</title>
    <meta name="description" content="Local-first AI that understands household context, coordinates supported devices, remembers what matters, and keeps private data at home." />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" data-media-slot="site-favicon" />
    <meta property="og:title" content="A mind for the household. Finally at home." />
    <meta property="og:description" content="Local-first AI that understands household context, coordinates supported devices, remembers what matters, and keeps private data at home." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`https://harbornavi.com${heroSocialImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="A mind for the household. Finally at home." />
    <meta name="twitter:description" content="Local-first AI that understands household context, coordinates supported devices, remembers what matters, and keeps private data at home." />
    <meta name="twitter:image" content={`https://harbornavi.com${heroSocialImage}`} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body class:list={["home-v6-page", { "home-v9-page": isV9 }]} data-route={route}>
    <div class="site-shell">
      <div class="site-header-v7-bar">
        <header class="site-header-v7">
          <a class="site-header-v7-brand" href="#top" aria-label="HarborNavi home">
            <span class="site-header-v7-mark" aria-hidden="true"><img src="/harbornavi-logo-mark.png" alt="" width="42" height="23" data-media-slot="site-header-logo" /></span>
            <span class="site-header-v7-brand-name">HarborNavi</span>
          </a>
          <nav id="site-header-v7-navigation" class="site-header-v7-nav" aria-label="Page sections">
            <a href="#intelligence">Intelligence</a>
            <a href="#how-it-works">How it works</a>
            <a href="#compatibility">Compatibility</a>
            <a href="#hardware">Hardware</a>
            <a href="#compare">Compare</a>
            <a href="/about-harbor">About Harbor</a>
          </nav>
          <a class="site-header-v7-cta" href="/pilot-families">Join the Pilot Program</a>
          <button class="site-header-v7-menu" type="button" aria-label="Open navigation menu" aria-controls="site-header-v7-navigation" aria-expanded="false" data-header-menu>
            <span class="site-header-v7-menu-open" aria-hidden="true"><Menu size={20} strokeWidth={2} /></span>
            <span class="site-header-v7-menu-close" aria-hidden="true"><X size={20} strokeWidth={2} /></span>
          </button>
        </header>
        <SiteHeaderMenu />
      </div>

      <main id="top">
        <section class="hero-carousel" data-hero-carousel aria-label="HarborNavi highlights">
          <div class="hero-carousel-track" data-carousel-slides>
            {heroCarouselSlides.map((slide, index) => (
              <article class="hero-carousel-slide" data-carousel-slide aria-hidden={index === 0 ? "false" : "true"} hidden={index !== 0}>
                <img src={slide.url} alt={slide.alt} width={slide.width} height={slide.height} loading={index === 0 ? "eager" : "lazy"} decoding="async" data-media-slot={index === 0 ? "home-carousel-pilot" : index === 1 ? "home-carousel-memory" : "home-carousel-movie"} />
                {slide.href ? (
                  <a class="hero-carousel-link" href={slide.href} aria-label={`${slide.title}. ${slide.cta}`}>
                    <div class="hero-carousel-overlay">
                      <p>{slide.eyebrow}</p>
                      <h2>{slide.highlight ? <>Join the <mark>First 5</mark> Pilot Families</> : slide.title}</h2>
                      {slide.description && <span>{slide.description}</span>}
                      {slide.cta && <strong>{slide.cta}</strong>}
                    </div>
                  </a>
                ) : (
                  <div class="hero-carousel-overlay">
                    <p>{slide.eyebrow}</p>
                    <h2>{slide.title}</h2>
                  </div>
                )}
              </article>
            ))}
          </div>
          <div class="hero-carousel-controls">
            <div class="hero-carousel-dots" data-carousel-dots aria-label="Choose a highlight">
              {heroCarouselSlides.map((_, index) => (
                <button type="button" data-carousel-dot={index} aria-label={`Show highlight ${index + 1}`} aria-current={index === 0 ? "true" : "false"}></button>
              ))}
            </div>
            <div class="hero-carousel-arrows">
              <button type="button" data-carousel-prev aria-label="Previous highlight">&larr;</button>
              <button type="button" data-carousel-next aria-label="Next highlight">&rarr;</button>
            </div>
          </div>
        </section>
        <section class="hero" aria-labelledby="hero-title">
          {isV9 && <p class="v9-hero-kicker"><span aria-hidden="true"></span>Local household intelligence &middot; Private by design</p>}
          <h1 id="hero-title">A mind for the household. {isV9 ? <span>Finally at home.</span> : "Finally at home."}</h1>
          <div class="hero-copy">
            <p class="category">Sci-fi intelligence. Home-warmed care. Kept entirely at home.</p>
            <div class="hero-description">
              <p>HarborNavi gives the home you already own one local mind: it understands context, remembers what matters, and turns plain words into coordinated action without sending your private household data away.</p>
            </div>
            <div class="waitlist-signup">
              <p class="waitlist-benefit">Enter your email for early-bird pricing and launch updates.</p>
              <form class="email-form" data-early-form data-form-location="hero">
                <label class="sr-only" for="v6-hero-email">Email address</label>
                <input id="v6-hero-email" type="email" name="email" autocomplete="email" placeholder="Email address" aria-describedby="v6-hero-note v6-hero-error" required />
                <input class="sr-only" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <button type="submit">Join the waitlist</button>
              </form>
            </div>
            <aside class="waitlist-countboard" aria-label="HarborNavi waitlist milestone">
              <span class="waitlist-countboard-label"><span aria-hidden="true"></span>Waitlist milestone</span>
              <span class="waitlist-countboard-total"><strong>500+</strong><span>people have joined</span></span>
            </aside>
            <p id="v6-hero-error" class="form-error" data-form-error aria-live="polite" hidden>We could not save your email. Please try again.</p>
            <p id="v6-hero-note" class="form-note">Submit once to join the waitlist and receive product updates. Unsubscribe anytime. <a href="/privacy">Privacy</a></p>
          </div>
          <figure class="hero-visual">
            <img src={heroImage} alt="A family interacting at home while HarborNavi coordinates household context locally" width="1536" height="1024" loading="eager" fetchpriority="high" data-media-slot="home-hero-family" />
          </figure>
        </section>

        <section id="intelligence" class="memory-story" aria-labelledby="intelligence-title" data-scenario-event="scenario_family_memory">
          <figure class="memory-visual">
            <img src="/assets/home-v7-v8-family-moment-id.webp" alt="HarborNavi connecting selected household signals into useful local context" width="1536" height="1024" loading="lazy" data-media-slot="home-memory-moment" />
          </figure>
          <div class="memory-copy">
            <p class="eyebrow">The mind smart homes were missing</p>
            <h2 id="intelligence-title">Your devices have signals. HarborNavi understands the situation.</h2>
            <p>Cameras see. Speakers listen. Apps send alerts. HarborNavi is designed to connect the selected pieces into local household context that can support a useful response.</p>
            <div class="moment-lines" aria-label="How HarborNavi turns home signals into intelligence">
              <div><span>Device signals</span><strong>One household context</strong></div>
              <div><span>Changing routines</span><strong>Clarified, not hard-coded</strong></div>
              <div><span>Plain words</span><strong>Coordinated response</strong></div>
            </div>
          </div>
        </section>

        <section class="briefing-story" aria-labelledby="briefing-title" data-scenario-event="scenario_home_briefing">
          <div class="briefing-copy">
            <p class="eyebrow">It knows what matters now</p>
            <h2 id="briefing-title">The short version, before you have to ask.</h2>
            <p>Navi is designed to let routine moments wait, surface configured urgent changes, and give you the calm version when you get home.</p>
            <div class="briefing-list" aria-label="Example home briefing">
              <div><time>2:14 PM</time><span>Package delivered</span><em>Routine</em></div>
              <div><time>4:32 PM</time><span>Pet moment worth keeping</span><em>Saved</em></div>
              <div><time>5:08 PM</time><span>Window stayed open</span><em>Mention at home</em></div>
            </div>
          </div>
          <figure>
            <img src="/assets/home-v7-v8-homecoming-briefing-id.webp" alt="A family member coming home to a dog, with HarborNavi ready to share the short version of the day" width="1536" height="1024" loading="lazy" data-media-slot="home-briefing" />
          </figure>
        </section>

        <section id="how-it-works" class="layers-section" aria-labelledby="layers-title" data-scenario-event="scenario_memory_understand_act">
          <div class="section-heading centered-heading">
            <p class="eyebrow">A quiet intelligence at home</p>
            <h2 id="layers-title">One local mind. Three jobs.</h2>
            <p class="stack-equation">Understand context + Orchestrate devices + Remember what matters</p>
          </div>
          <div class="layer-flow">
            {intelligenceLayers.map((layer, index) => (
              <>
                <article class:list={["layer", `layer-${index + 1}`]}>
                  <div class="layer-meta"><span>{layer.index}</span><em>{layer.label}</em></div>
                  <h3>{layer.title}</h3>
                  <p>{layer.body}</p>
                  <small>{layer.detail}</small>
                </article>
                {index < intelligenceLayers.length - 1 && <span class="layer-arrow" aria-hidden="true">&rarr;</span>}
              </>
            ))}
          </div>
          <div class="memory-loop"><span aria-hidden="true">&larr;</span><p>Each approved interaction gives the next request useful context, so the home does not start from zero every time.</p></div>
        </section>

        <section class="proof-section" aria-label="HarborNavi in action">
          <article class="proof-story package-story" data-scenario-event="scenario_package_response">
            <div class="proof-copy">
              <p class="eyebrow">Instinct, with boundaries</p>
              <h2>It notices what changed, not just that something moved.</h2>
              <p>HarborNavi can connect delivery and presence signals, notify you, save the key clip, and prepare an allowed response. Escalation stays with you.</p>
              <blockquote>Package removed after delivery. Owner notified. Supported porch warning ready.</blockquote>
            </div>
            <figure><img src="/assets/home-v4-package-response.webp" alt="A package-removal event prompting an immediate owner notification and supported porch response" width="1536" height="1024" loading="lazy" data-media-slot="home-package-response" /></figure>
          </article>

          <article class="proof-story movie-story" data-scenario-event="scenario_natural_language_action">
            <figure><img src="/assets/home-v7-v8-movie-night-id.webp" alt="A movie-night request coordinating lighting, television, and climate devices" width="1536" height="1024" loading="lazy" data-media-slot="home-movie-night" /></figure>
            <div class="proof-copy">
              <p class="eyebrow">The plain-words bridge</p>
              <h2>&quot;Movie night&quot; should be enough.</h2>
              <p>HarborNavi uses local household context and your room and device mappings, asks what is unclear, and builds a temporary plan instead of another rule to maintain.</p>
              <div class="conversation" aria-label="Example movie night conversation">
                <p class="from-user"><span>You</span>Movie night.</p>
                <p><span>HarborNavi</span>Living-room TV, lights at 20%, AC at 72&deg;F?</p>
                <p class="from-user"><span>You</span>Yes, and mute routine alerts for two hours.</p>
                <strong>4 devices &middot; 1 temporary plan &middot; Ready to enable</strong>
              </div>
            </div>
          </article>

          <aside id="goodix-security" class="trust-story" data-scenario-event="scenario_trust_boundary">
            <div class="trust-copy">
              <p class="eyebrow">For sensitive changes</p>
              <h2>One touch confirms it's you. Hardware protects what comes next.</h2>
              <p>Before anyone adds a family member, changes permissions, or pairs a device, HarborNavi can require a fingerprint scan on the box. Matching happens inside the fingerprint module, while an eSE chip protects the device identity and encryption keys behind the approval.</p>
            </div>
            <figure>
              <img src="/assets/home-v7-v8-trust-boundary-id.webp" alt="A person confirming a sensitive HarborNavi change with a fingerprint at the box, above the front infrared window" width="1536" height="1024" loading="lazy" data-media-slot="home-trust-boundary" />
              <figcaption>A protected change continues only after local fingerprint confirmation.</figcaption>
            </figure>
            <div class="fingerprint-detail">
              <div class="fingerprint-sequence security-chain">
                <p class="fingerprint-label">How a protected change is approved</p>
                <ol>
                  <li class="match-on-chip-step"><span><Fingerprint size={20} strokeWidth={1.8} aria-hidden="true" /></span><div><small>01 &middot; Match-on-Chip</small><strong>Confirm it's you</strong><p>Your fingerprint is checked inside the fingerprint module, so HarborNavi's main system does not perform the biometric comparison.</p></div></li>
                  <li><span><LockKeyhole size={20} strokeWidth={1.8} aria-hidden="true" /></span><div><small>02 &middot; Security solution</small><strong>Keep identity and keys protected</strong><p>An eSE chip separates device identity, trusted credentials, and encryption keys from the main system.</p></div></li>
                  <li><span><Workflow size={20} strokeWidth={1.8} aria-hidden="true" /></span><div><small>03 &middot; Permission check</small><strong>Approve only this change</strong><p>HarborNavi checks the person, permission, and request. One successful match never unlocks everything.</p></div></li>
                </ol>
              </div>
              <div class="ese-certification" aria-label="Embedded Secure Element security certification">
                <p class="fingerprint-label">Security-chip certification</p>
                <strong class="ese-certification-level"><small>SOGIS</small>CC EAL5<span>+</span></strong>
                <h3>Independently evaluated security.</h3>
                <p>The eSE chip and its COS have achieved SOGIS CC EAL5+ certification under Common Criteria, a widely recognized international framework for evaluating security products.</p>
                <a href="https://www.goodix.com/en/product/security_products/ese" target="_blank" rel="noreferrer">Learn about the eSE technology <span aria-hidden="true">&nearr;</span></a>
                <small class="certification-scope">Certification applies to the selected security chip, not HarborNavi as a complete product. Final hardware remains subject to validation, and secure software and access controls are still required.</small>
              </div>
              <details class="fingerprint-technical-sequence">
                <summary>For technical readers</summary>
                <p>Finger touches sensor &rarr; touch-wake circuit raises <code>key_int</code> &rarr; main MCU wakes &rarr; MCU drives <code>WAKEUP</code> high &rarr; fingerprint algorithm chip initializes and completes the match &rarr; authorized result enters the protected-action policy path &rarr; MCU drives <code>WAKEUP</code> low &rarr; module and system return to sleep.</p>
              </details>
            </div>
          </aside>
        </section>

        <section id="privacy-tech" class="privacy-tech-section" aria-labelledby="privacy-tech-title" data-scenario-event="scenario_dynamic_privacy">
          <div class="privacy-tech-intro">
            <p class="eyebrow">Privacy is the foundation</p>
            <h2 id="privacy-tech-title">Your home, finally fluent. Your data, finally home.</h2>
            <p class="privacy-partnership-copy">
              <strong class="privacy-partnership-highlight">HarborNavi is integrating Mode IO.AI's dynamic privacy and AI safety technology into its local-first architecture.</strong>
              <span>Sensitive context can be reviewed before an optional external model receives a request, while private household context remains on HarborNavi.</span>
            </p>
            <a href="https://modeio.ai/ai-governance" target="_blank" rel="noreferrer">Explore Mode IO.AI privacy technology <span aria-hidden="true">&nearr;</span></a>
