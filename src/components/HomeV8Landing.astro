      <div class="modal" data-success-modal hidden role="dialog" aria-modal="true" aria-labelledby="v6-success-title" aria-describedby="v6-success-description">
        <button class="modal-backdrop" type="button" tabindex="-1" aria-label="Close thank you dialog" data-modal-close></button>
        <div class="modal-panel">
          <button class="modal-close" type="button" aria-label="Close thank you dialog" data-modal-close>&times;</button>
          <p class="eyebrow" data-success-eyebrow>You're on the list</p>
          <h2 id="v6-success-title" data-success-title>Welcome to the HarborNavi waitlist.</h2>
          <p id="v6-success-description" data-success-description>Your email has been added. No confirmation step is required.</p>
          <div class="survey-invite" data-confirmation-extras>
            <p class="survey-label">Optional &middot; About 3&ndash;5 minutes</p>
            <h3>Help us build HarborNavi around real homes.</h3>
            <p>Tell us which devices you already use and what you would most want HarborNavi to help with. Your answers will guide compatibility testing and product priorities.</p>
          </div>
          <div class="modal-actions" data-confirmation-extras>
            <a class="modal-primary-link" href={surveyUrl} target="_blank" rel="noreferrer" data-survey-link>Take the short survey <span aria-hidden="true">&rarr;</span></a>
            <a href={discordUrl} target="_blank" rel="noreferrer" data-discord-link>Join the optional Discord discussion <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </div>
