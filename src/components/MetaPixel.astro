---
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID?.trim() || "1257319255516210";
const enabled = /^\d{5,20}$/.test(pixelId);
const consentCookieName = "harbornavi_marketing_consent";
---

{enabled && (
  <script is:inline define:vars={{ consentCookieName, pixelId }}>
    (() => {
      if (window.harborMetaPixelInstalled) return;
      window.harborMetaPixelInstalled = true;

      const conversionEvents = {
        early_bird_saved: {
          name: "Lead",
          parameters: {
            content_name: "HarborNavi Waitlist",
            content_category: "Email Signup"
          }
        },
        pilot_apply_saved: {
          name: "Lead",
          parameters: {
            content_name: "HarborNavi Pilot Program",
            content_category: "Pilot Application"
          }
        }
      };

      function hasMarketingConsent() {
        return document.cookie.split("; ").some((part) => part === `${consentCookieName}=granted`);
      }

      const searchParams = new URLSearchParams(window.location.search);
      const testEventCode = searchParams.get("test_event_code") || "";
      const metaTestReferrer = /^https:\/\/(?:eventsmanager|business)\.facebook\.com(?:\/|$)/i.test(document.referrer || "");
      const metaTestMode = searchParams.get("meta_test") === "1"
        || /^TEST[A-Z0-9_-]{3,64}$/i.test(testEventCode)
        || metaTestReferrer;
      let marketingAllowed = hasMarketingConsent();
      let testModeAllowed = metaTestMode;
      let initialized = false;

      function updateTestStatus(state, eventName = "", eventId = "") {
        if (!metaTestMode) return;
        document.documentElement.dataset.metaPixelState = state;
        document.documentElement.dataset.metaPixelConsent = hasMarketingConsent()
          ? "granted"
          : testModeAllowed
            ? "test-mode"
            : "not-granted";
        if (eventName) document.documentElement.dataset.metaPixelLastEvent = eventName;
        if (eventId) document.documentElement.dataset.metaPixelLastEventId = eventId;
      }

      function createEventId(eventName) {
        const randomPart = window.crypto?.randomUUID?.()
          || Math.random().toString(36).slice(2);
        return `harbornavi_${eventName.toLowerCase()}_${Date.now()}_${randomPart}`;
      }

      function queuePixelEvent(eventName, parameters = {}) {
        const eventId = createEventId(eventName);
        window.fbq("track", eventName, parameters, { eventID: eventId });
        updateTestStatus("event-queued", eventName, eventId);
      }

      function initializePixel() {
        if ((!marketingAllowed && !testModeAllowed) || initialized) {
          if (!marketingAllowed) updateTestStatus("waiting-for-consent");
          return;
        }
        initialized = true;

        if (!window.fbq) {
          const meta = window.fbq = function (...args) {
            if (meta.callMethod) {
              meta.callMethod.apply(meta, args);
            } else {
              meta.queue.push(args);
            }
          };
          if (!window._fbq) window._fbq = meta;
          meta.push = meta;
          meta.loaded = true;
          meta.version = "2.0";
          meta.queue = [];

          const script = document.createElement("script");
          script.async = true;
          script.src = "https://connect.facebook.net/en_US/fbevents.js";
          script.addEventListener("load", () => updateTestStatus("library-loaded"));
          script.addEventListener("error", () => updateTestStatus("library-blocked"));
          const firstScript = document.getElementsByTagName("script")[0];
          firstScript?.parentNode?.insertBefore(script, firstScript);
        }

        window.fbq("init", pixelId);
        queuePixelEvent("PageView");
      }

      window.harborMetaTrack = (eventName) => {
        marketingAllowed = hasMarketingConsent();
        if (!marketingAllowed && !testModeAllowed) return;

        const conversion = conversionEvents[eventName];
        if (!conversion) return;

        initializePixel();
        queuePixelEvent(conversion.name, conversion.parameters);
      };

      const previousMarketingConsentHandler = window.harborSetMarketingConsent;
      window.harborSetMarketingConsent = (granted) => {
        previousMarketingConsentHandler?.(granted);
        marketingAllowed = Boolean(granted);
        if (marketingAllowed) {
          testModeAllowed = true;
          updateTestStatus("consent-granted");
          initializePixel();
        } else {
          testModeAllowed = false;
          updateTestStatus("consent-denied");
        }
      };

      updateTestStatus(marketingAllowed ? "consent-restored" : "waiting-for-consent");
      initializePixel();
    })();
  </script>
)}
