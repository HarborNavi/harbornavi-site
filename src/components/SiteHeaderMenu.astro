<script>
  const initializeHeaderMenus = () => {
    document.querySelectorAll<HTMLElement>(".site-header-v7").forEach((header) => {
      if (header.dataset.menuReady === "true") return;

      const button = header.querySelector<HTMLButtonElement>("[data-header-menu]");
      const navigation = header.querySelector<HTMLElement>(".site-header-v7-nav");
      const productMenu = header.querySelector<HTMLDetailsElement>("[data-header-product-menu]");
      if (!button || !navigation) return;

      header.dataset.menuReady = "true";

      const setOpen = (open: boolean) => {
        header.dataset.menuOpen = open ? "true" : "false";
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
      };

      button.addEventListener("click", () => {
        setOpen(button.getAttribute("aria-expanded") !== "true");
      });

      navigation.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) {
          if (productMenu) productMenu.open = false;
          setOpen(false);
        }
      });

      document.addEventListener("click", (event) => {
        if (header.dataset.menuOpen === "true" && !header.contains(event.target as Node)) {
          setOpen(false);
        }
        if (productMenu?.open && !productMenu.contains(event.target as Node)) {
          productMenu.open = false;
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        if (productMenu?.open) {
          productMenu.open = false;
          productMenu.querySelector<HTMLElement>("summary")?.focus();
          return;
        }
        if (header.dataset.menuOpen === "true") {
          setOpen(false);
          button.focus();
        }
      });

      window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
    });
  };

  initializeHeaderMenus();
  document.addEventListener("astro:page-load", initializeHeaderMenus);
</script>
