---
import { Menu, X } from "@lucide/astro";
import SiteHeaderMenu from "./SiteHeaderMenu.astro";
import SiteHeaderProductMenu from "./SiteHeaderProductMenu.astro";
import { arePilotApplicationsOpen } from "../data/pilotProgram";
import "../styles/site-header-v7.css";

interface Props {
  ctaHref?: string;
  ctaLabel?: string;
  homeHref?: string;
}

const pilotApplicationsOpen = arePilotApplicationsOpen();
const {
  ctaHref = pilotApplicationsOpen ? "/pilot-families#apply" : "/pilot-families#pilot-waitlist",
  ctaLabel = pilotApplicationsOpen ? "Join the Pilot Program" : "Join the waitlist",
  homeHref = "/"
} = Astro.props;
---

<div class="site-header-v7-bar">
  <header class="site-header-v7">
    <a class="site-header-v7-brand" href={homeHref} aria-label="HarborNavi home">
      <span class="site-header-v7-mark" aria-hidden="true">
        <img src="/harbornavi-logo-mark.png" alt="" width="42" height="23" data-media-slot="site-header-logo" />
      </span>
      <span class="site-header-v7-brand-name">HarborNavi</span>
    </a>
    <nav id="site-header-v7-navigation" class="site-header-v7-nav" aria-label="Page sections">
      <SiteHeaderProductMenu homeHref={homeHref} />
      <a href="/compare">Compare</a>
      <a href="/facts">Facts</a>
      <a href="/about-harbor">About Harbor</a>
    </nav>
    <a class="site-header-v7-cta" href={ctaHref} data-track="waitlist_start">{ctaLabel}</a>
    <button class="site-header-v7-menu" type="button" aria-label="Open navigation menu" aria-controls="site-header-v7-navigation" aria-expanded="false" data-header-menu>
      <span class="site-header-v7-menu-open" aria-hidden="true"><Menu size={20} strokeWidth={2} /></span>
      <span class="site-header-v7-menu-close" aria-hidden="true"><X size={20} strokeWidth={2} /></span>
    </button>
  </header>
  <SiteHeaderMenu />
</div>
