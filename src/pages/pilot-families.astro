---
import EnglishFormValidation from "../components/EnglishFormValidation.astro";
import MetaPixel from "../components/MetaPixel.astro";
import RedditPixel from "../components/RedditPixel.astro";
import SiteHeader from "../components/SiteHeaderV7.astro";
import SiteMediaLoader from "../components/SiteMediaLoader.astro";
import {
  pilotApplicationDeadline,
  pilotApplicationDeadlineLabel,
  pilotApplicationDeadlineShortLabel,
  pilotDisclosureExample,
  pilotRewardAdvertisingCopy,
  pilotSpotCount
} from "../data/pilotProgram";
import "../styles/global-v7.css";
import "../styles/pilot-families.css";
---

<!doctype html>
<html lang="en">
  <head>
    <EnglishFormValidation />
    <RedditPixel />
    <MetaPixel />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0c12" />
    <title>First 5 Pilot Families | HarborNavi</title>
    <meta name="description" content={`Apply for HarborNavi's two-week Pilot Families program. Selected families receive a new device and lifetime subscription-free access. ${pilotRewardAdvertisingCopy}`} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" data-media-slot="site-favicon" />
    <link rel="canonical" href="https://harbornavi.com/pilot-families" />
  </head>
  <body class="pilot-page" data-route="pilot-families">
    <SiteHeader ctaHref="#apply" />
    <main>
      <section class="pilot-hero" aria-labelledby="pilot-title">
        <img src="/assets/home-v7-v8-pilot-families-id.webp" alt="A family trying HarborNavi together during an early pilot experience" width="1802" height="873" fetchpriority="high" data-media-slot="pilot-hero" />
        <div class="pilot-hero-overlay"></div>
        <div class="pilot-hero-copy">
          <p class="eyebrow">HarborNavi Pilot Program</p>
          <p class="pilot-spots"><span aria-hidden="true"></span> Only {pilotSpotCount} pilot spots</p>
          <h1 id="pilot-title">Join the First 5 Pilot Families</h1>
          <p>Pilot your home with HarborNavi. Two weeks. Yours to keep. {pilotRewardAdvertisingCopy}</p>
          <a class="pilot-primary" href="#apply">Apply to Join <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section
        class="pilot-urgency"
        data-pilot-countdown
        data-deadline={pilotApplicationDeadline}
        aria-labelledby="pilot-deadline-title"
      >
        <div class="section-shell pilot-urgency-inner">
          <div class="pilot-urgency-copy">
            <p class="eyebrow">Application window</p>
            <h2 id="pilot-deadline-title">Applications close {pilotApplicationDeadlineShortLabel}.</h2>
            <p>Five families will be selected for the first two-week home pilot. Apply before the deadline to be considered.</p>
            <time datetime={pilotApplicationDeadline}>{pilotApplicationDeadlineLabel}</time>
          </div>
          <div class="pilot-countdown" role="timer" aria-label={`Time remaining until ${pilotApplicationDeadlineLabel}`}>
            <div><strong data-countdown-days>--</strong><span>Days</span></div>
            <div><strong data-countdown-hours>--</strong><span>Hours</span></div>
            <div><strong data-countdown-minutes>--</strong><span>Minutes</span></div>
            <div><strong data-countdown-seconds>--</strong><span>Seconds</span></div>
          </div>
          <p class="pilot-countdown-status" data-countdown-status aria-live="polite"></p>
        </div>
      </section>

      <section class="pilot-intro section-shell" aria-labelledby="pilot-intro-title">
        <div>
          <p class="eyebrow">Five homes. Real feedback.</p>
          <h2 id="pilot-intro-title">Help us build HarborNavi for real family life.</h2>
        </div>
        <p>Use HarborNavi with your current smart-home setup for two weeks, then tell us what worked and what should change.</p>
      </section>

      <section class="pilot-details section-shell" aria-label="Pilot family benefits">
        <article>
          <span>01</span>
          <h3>A new HarborNavi</h3>
          <p>Receive a brand-new HarborNavi device and keep it after completing the pilot.</p>
        </article>
        <article>
          <span>02</span>
          <h3>No subscription fees, for life</h3>
          <p>Keep lifetime subscription-free access on your pilot device.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Milestone-based reward</h3>
          <p>{pilotRewardAdvertisingCopy}</p>
        </article>
      </section>

      <section class="pilot-commitment section-shell" aria-labelledby="commitment-title">
        <div class="pilot-commitment-copy">
          <p class="eyebrow">A focused two-week pilot</p>
          <h2 id="commitment-title">Use it at home. Show us what works.</h2>
          <p>The pilot fits into normal family life. You will see the schedule, milestones, and terms before deciding.</p>
        </div>
        <div class="pilot-commitment-grid">
          <article>
            <p class="eyebrow">What pilot families do</p>
            <h3>Install, use, and document the experience.</h3>
            <ul>
              <li>Set up HarborNavi in about 30 minutes with live, step-by-step support.</li>
              <li>Use it in normal household routines for two weeks.</li>
              <li>Share structured feedback through short check-ins.</li>
              <li>Record one or two short vlogs about the experience and include the required benefit disclosure if they are shared or published.</li>
            </ul>
          </article>
          <article>
            <p class="eyebrow">Who we are looking for</p>
            <h3>Families ready to give practical, honest feedback.</h3>
            <ul>
              <li>A stable home Wi-Fi connection.</li>
              <li>At least one compatible camera or Home Assistant device.</li>
              <li>An adult who can participate in setup and feedback sessions.</li>
              <li>Comfort sharing what works, what is confusing, and what should change.</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="pilot-disclosure section-shell" aria-labelledby="pilot-disclosure-title">
        <div class="pilot-disclosure-copy">
          <p class="eyebrow">Creator and participant disclosure</p>
          <h2 id="pilot-disclosure-title">Make every HarborNavi benefit clear.</h2>
          <p>Creators, selected pilot families, and anyone publishing a later pilot vlog, review, testimonial, or endorsement must clearly and conspicuously disclose their material connection to HarborNavi.</p>
          <a href="https://www.ftc.gov/business-guidance/resources/disclosures-101-social-media-influencers" target="_blank" rel="noreferrer">Read FTC Disclosures 101 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="pilot-disclosure-rules">
          <ul>
            <li><strong>Disclose every benefit</strong><span>State any cash compensation, free or provided HarborNavi device, lifetime subscription-free access, or other benefit.</span></li>
            <li><strong>Put it where people will see it</strong><span>Place the disclosure with the endorsement, before a “more” break, and in the same language as the content.</span></li>
            <li><strong>Disclose inside every video</strong><span>For vlogs and other video, include the disclosure clearly in the video itself, not only in a caption or description. HarborNavi requires both visible on-screen text and a spoken disclosure.</span></li>
          </ul>
          <blockquote><strong>Plain-language example</strong><span>“{pilotDisclosureExample}”</span></blockquote>
        </div>
      </section>

      <section class="pilot-privacy section-shell" aria-labelledby="pilot-privacy-title">
        <div>
          <p class="eyebrow">Private by design</p>
          <h2 id="pilot-privacy-title">Your home data stays in your home.</h2>
          <p>HarborNavi does not collect your household's camera footage, device credentials, or private home timeline as part of the pilot. Home data is processed locally on HarborNavi.</p>
        </div>
        <ul>
          <li><strong>Local processing</strong><span>Camera events, device context, and home memories are handled on the HarborNavi device.</span></li>
          <li><strong>Minimal application data</strong><span>We ask only for contact information and a high-level device summary during selection.</span></li>
          <li><strong>You control sharing</strong><span>You decide what feedback, vlog footage, and optional diagnostics to share with the team.</span></li>
        </ul>
      </section>

      <section class="pilot-process section-shell" aria-labelledby="process-title">
        <div class="pilot-process-copy">
          <p class="eyebrow">How selection works</p>
          <h2 id="process-title">Apply, talk with us, then decide.</h2>
          <p>We review compatibility, availability, and the feedback you hope to share. Applying does not guarantee selection or create a marketing subscription.</p>
          <ol>
            <li><strong>Apply</strong><span>Share your current smart-home setup and why the pilot interests you.</span></li>
            <li><strong>Review</strong><span>The HarborNavi team reviews applications for pilot fit.</span></li>
            <li><strong>Confirm</strong><span>Selected families receive the final schedule, milestones, reward terms, and participation agreement before deciding.</span></li>
          </ol>
        </div>
        <aside>
          <p class="eyebrow">Before you decide</p>
          <h3>Clear terms before installation.</h3>
          <p>Selected families receive the final schedule, device terms, agreed milestones, reward terms, disclosure requirements, and participation agreement before committing.</p>
          <a href="#pilot-faq">Read the pilot FAQ <span aria-hidden="true">→</span></a>
        </aside>
      </section>

      <section id="pilot-faq" class="pilot-faq section-shell" aria-labelledby="pilot-faq-title">
        <div class="pilot-faq-heading">
          <p class="eyebrow">Pilot FAQ</p>
          <h2 id="pilot-faq-title">What families ask before joining.</h2>
        </div>
        <div class="pilot-faq-list">
          <details>
            <summary>What will my family need to do?</summary>
            <p>Plan for a 30-minute guided setup, use HarborNavi in normal routines for two weeks, complete short feedback check-ins, and record one or two short vlogs. Any shared or published vlog must include the required benefit disclosure.</p>
          </details>
          <details>
            <summary>How difficult is installation?</summary>
            <p>Most pilot homes should finish setup in about 30 minutes. A HarborNavi team member will guide you live, step by step, with remote or in-person support depending on location.</p>
          </details>
          <details>
            <summary>What equipment do I need?</summary>
            <p>You need stable Wi-Fi and at least one compatible camera or Home Assistant device. We will confirm compatibility before selection is final.</p>
          </details>
          <details>
            <summary>How long is the pilot program?</summary>
            <p>The active home-use period is two weeks, plus a short setup session and final feedback check-in.</p>
          </details>
          <details>
            <summary>Do I get to keep the device?</summary>
            <p>Yes. Families that complete the pilot keep their HarborNavi device.</p>
          </details>
          <details>
            <summary>What happens after the pilot?</summary>
            <p>You keep the HarborNavi device and receive lifetime subscription-free access for that pilot device. {pilotRewardAdvertisingCopy}</p>
          </details>
          <details>
            <summary>What must I disclose in a vlog, review, or post?</summary>
            <p>Clearly disclose every HarborNavi benefit you received or may receive, including cash, a provided or free device, lifetime subscription-free access, or another benefit. Put the disclosure where it is easy to notice. For video, include it visibly and verbally in the video itself, not only in the caption or description.</p>
          </details>
        </div>
      </section>

      <section id="apply" class="pilot-application section-shell" aria-labelledby="application-title">
        <div class="pilot-application-intro">
          <p class="eyebrow">Pilot application</p>
          <h2 id="application-title">Apply for the HarborNavi pilot.</h2>
          <p>Six quick questions help us confirm compatibility and select a varied first group. A submitted application is not a guarantee of selection.</p>
        </div>
        <form data-pilot-form>
          <label> Name <input type="text" name="name" autocomplete="name" maxlength="120" required /> </label>
          <label> Email <input type="email" name="email" autocomplete="email" maxlength="254" required /> </label>
          <label> ZIP Code <input type="text" name="zip_code" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" data-pattern-message="Please enter a valid ZIP code, such as 94107." maxlength="10" required /> </label>
          <label class="full-field"> What smart devices do you currently use? <textarea name="smart_devices" rows="4" maxlength="1200" required></textarea> </label>
          <label class="full-field"> Why are you interested? <textarea name="interest_reason" rows="4" maxlength="1200" required></textarea> </label>
          <label class="full-field"> How did you hear about us?
            <select name="referral_source" required>
              <option value="">Select one</option>
              <option value="search">Search</option>
              <option value="social">Social media</option>
              <option value="friend-family">Friend or family</option>
              <option value="kickstarter">Kickstarter</option>
              <option value="community-event">Community or event</option>
              <option value="other">Other</option>
            </select>
          </label>
          <input class="pilot-honeypot" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="pilot-form-note full-field">By submitting, you are applying only to the pilot program. This does not subscribe you to marketing email. See <a href="/privacy">Privacy</a>.</p>
          <p class="pilot-form-message full-field" data-pilot-message aria-live="polite" hidden></p>
          <button class="pilot-primary full-field" type="submit">Submit application <span aria-hidden="true">→</span></button>
        </form>
      </section>
    </main>
    <footer class="site-footer"><span>HarborNavi</span><a href="/">Home</a><a href="/about-harbor">About Harbor</a><a href="/privacy">Privacy</a></footer>

    <SiteMediaLoader />
    <script is:inline>
      const route = document.body.dataset.route || "pilot-families";
      const utmKeys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"];
      const pilotCountdown = document.querySelector("[data-pilot-countdown]");
      const pilotForm = document.querySelector("[data-pilot-form]");
      const pilotMessage = document.querySelector("[data-pilot-message]");

      function getSessionId() {
        const key = "harbornavi_session_id";
        let value = window.sessionStorage.getItem(key);
        if (!value) {
          value = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
          window.sessionStorage.setItem(key, value);
        }
        return value;
      }

      function getUtmPayload() {
        const params = new URLSearchParams(window.location.search);
        const current = {};
        let hasCurrent = false;
        utmKeys.forEach((key) => {
          const value = params.get(key) || "";
          current[key] = value;
          hasCurrent = hasCurrent || Boolean(value);
        });
        if (hasCurrent) {
          window.sessionStorage.setItem("harbornavi_utm", JSON.stringify(current));
          return current;
        }
        try {
          return JSON.parse(window.sessionStorage.getItem("harbornavi_utm") || "{}");
        } catch {
          return {};
        }
      }

      function analyticsPayload(eventName, properties) {
        const utm = getUtmPayload();
        return {
          event_name: eventName,
          route,
          path: window.location.pathname,
          referrer: document.referrer,
          form_location: properties?.form_location || "",
          session_id: getSessionId(),
          utm_source: utm.utm_source || "",
          utm_medium: utm.utm_medium || "",
          utm_campaign: utm.utm_campaign || "",
          utm_content: utm.utm_content || "",
          utm_term: utm.utm_term || "",
          properties: properties || {}
        };
      }

      window.harborTrack = function harborTrack(eventName, properties) {
        window.harborRedditTrack?.(eventName);
        const body = JSON.stringify(analyticsPayload(eventName, properties || {}));
        if (navigator.sendBeacon) {
          const queued = navigator.sendBeacon("/api/events", new Blob([body], { type: "application/json" }));
          if (queued) return;
        }
        fetch("/api/events", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body,
          keepalive: true
        }).catch(() => {});
      };

      window.harborTrack("page_view", { route });

      if (pilotCountdown) {
        const deadline = Date.parse(pilotCountdown.dataset.deadline || "");
        const countdownValues = {
          days: pilotCountdown.querySelector("[data-countdown-days]"),
          hours: pilotCountdown.querySelector("[data-countdown-hours]"),
          minutes: pilotCountdown.querySelector("[data-countdown-minutes]"),
          seconds: pilotCountdown.querySelector("[data-countdown-seconds]")
        };
        const countdownStatus = pilotCountdown.querySelector("[data-countdown-status]");
        let countdownTimer = null;

        const updateCountdown = () => {
          const remaining = deadline - Date.now();
          if (!Number.isFinite(deadline) || remaining <= 0) {
            Object.values(countdownValues).forEach((element) => { if (element) element.textContent = "00"; });
            pilotCountdown.dataset.closed = "true";
            if (countdownStatus) countdownStatus.textContent = "Pilot applications are now closed.";
            pilotForm?.querySelectorAll("input, textarea, select, button").forEach((element) => {
              element.disabled = true;
            });
            const submitButton = pilotForm?.querySelector("button[type='submit']");
            if (submitButton) submitButton.textContent = "Applications closed";
            if (countdownTimer) window.clearInterval(countdownTimer);
            return;
          }

          const totalSeconds = Math.floor(remaining / 1000);
          const values = {
            days: Math.floor(totalSeconds / 86400),
            hours: Math.floor((totalSeconds % 86400) / 3600),
            minutes: Math.floor((totalSeconds % 3600) / 60),
            seconds: totalSeconds % 60
          };
          Object.entries(values).forEach(([key, value]) => {
            const element = countdownValues[key];
            if (element) element.textContent = String(value).padStart(2, "0");
          });
        };

        updateCountdown();
        countdownTimer = window.setInterval(updateCountdown, 1000);
      }

      let pilotFormStarted = false;
      pilotForm?.addEventListener("focusin", () => {
        if (pilotFormStarted) return;
        pilotFormStarted = true;
        window.harborTrack("pilot_apply_start", { route, form_location: "pilot_application" });
      });

      pilotForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const button = pilotForm.querySelector("button[type='submit']");
        const data = new FormData(pilotForm);
        const utm = getUtmPayload();
        window.harborTrack("pilot_apply_submit", { route, form_location: "pilot_application" });
        button.disabled = true;
        pilotMessage.hidden = true;
        try {
          const response = await fetch("/api/pilot-application", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              ...Object.fromEntries(data.entries()),
              route,
              path: window.location.pathname,
              referrer: document.referrer,
              session_id: getSessionId(),
              utm_source: utm.utm_source || "",
              utm_medium: utm.utm_medium || "",
              utm_campaign: utm.utm_campaign || "",
              utm_content: utm.utm_content || "",
              utm_term: utm.utm_term || ""
            })
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(body.error || "We could not submit your application.");
          window.harborTrack("pilot_apply_saved", { route, form_location: "pilot_application" });
          pilotForm.reset();
          pilotMessage.textContent = "Application received. We will contact selected families with the next steps.";
          pilotMessage.dataset.tone = "success";
        } catch (error) {
          window.harborTrack("pilot_apply_error", { route, form_location: "pilot_application" });
          pilotMessage.textContent = error instanceof Error ? error.message : "We could not submit your application.";
          pilotMessage.dataset.tone = "error";
        } finally {
          pilotMessage.hidden = false;
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>
