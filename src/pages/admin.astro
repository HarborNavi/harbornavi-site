---
import SiteHeader from "../components/SiteHeader.astro";
import { landingAssets } from "../data/landingAssets";
import "../styles/global.css";

const githubAssetsUrl = "https://github.com/HarborNavi/harbornavi-site/tree/main/public/assets";
const vercelDeploymentsUrl = "https://vercel.com/bebebeabeanbeans-projects/harbornavi-site";
const assetSlots = [
  {
    label: "Home hero",
    path: "public/assets/hero-home.png",
    asset: landingAssets.homeHero
  },
  {
    label: "Package hero",
    path: "public/assets/hero-package.png",
    asset: landingAssets.packageHero
  },
  {
    label: "Pet hero",
    path: "public/assets/hero-pets.png",
    asset: landingAssets.petHero
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Landing Asset Updates | HarborNavi</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-route="admin">
    <SiteHeader activeRoute="privacy" />
    <main>
      <section class="admin-page section-shell" aria-labelledby="admin-title">
        <div class="admin-head">
          <div>
            <p class="eyebrow">Asset workflow</p>
            <h1 id="admin-title">Update landing images through GitHub.</h1>
          </div>
          <a class="secondary-link" href="/home">View site</a>
        </div>

        <div class="admin-guide">
          <article>
            <p class="card-label">Current flow</p>
            <h2>Replace the same files, keep the same names.</h2>
            <p>
              Upload the new images in GitHub under <code>public/assets</code>. Keep the filenames below unchanged so
              the landing page updates without code edits.
            </p>
          </article>
          <article>
            <p class="card-label">Deploy</p>
            <h2>Commit to main and Vercel will redeploy.</h2>
            <p>
              After GitHub receives the commit, Vercel rebuilds the static site. Use the deployment page to confirm the
              latest production build.
            </p>
          </article>
        </div>

        <div class="admin-actions">
          <a class="primary-button" href={githubAssetsUrl}>Open GitHub assets</a>
          <a class="secondary-link" href={vercelDeploymentsUrl}>View Vercel deployments</a>
        </div>

        <div class="admin-assets" aria-label="Landing image files">
          {assetSlots.map((slot) => (
            <article class="admin-asset">
              <div class="admin-preview">
                <img
                  src={slot.asset.url}
                  alt={slot.asset.alt}
                  width={slot.asset.width}
                  height={slot.asset.height}
                />
              </div>
              <div class="admin-asset-body">
                <div>
                  <p class="card-label">{slot.label}</p>
                  <h2>{slot.path}</h2>
                </div>
                <p class="admin-asset-meta">Recommended format: 1600 x 900 PNG, JPG, or WebP.</p>
                <p class="admin-asset-meta">
                  Keep visual content calm, real-home oriented, and consistent with the HarborNavi page style.
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <span>HarborNavi</span>
      <a href="/home">Home</a>
    </footer>
  </body>
</html>
