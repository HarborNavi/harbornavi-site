{
  "redirects": [
    {
      "source": "/",
      "destination": "/home-v9",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/home-v9",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/assets",
      "destination": "/api/admin/health?action=assets"
    },
    {
      "source": "/api/admin/pilot-applications",
      "destination": "/api/admin/health?action=pilot-applications"
    },
    {
      "source": "/api/waitlist/profile",
      "destination": "/api/waitlist?action=profile"
    },
    {
      "source": "/api/pilot-application",
      "destination": "/api/waitlist?action=pilot"
    },
    {
      "source": "/api/reservations/status",
      "destination": "/api/reservations?action=status"
    },
    {
      "source": "/api/reservations/checkout",
      "destination": "/api/reservations?action=checkout"
    },
    {
      "source": "/api/reservations/session",
      "destination": "/api/reservations?action=session"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/retry-waitlist",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/refund-reservations",
      "schedule": "0 3 * * *"
    }
  ]
}
