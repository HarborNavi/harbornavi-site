{
  "redirects": [
    {
      "source": "/setup",
      "destination": "/setup/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v4",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v5",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v6",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v7",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v8",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v9",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/assets",
      "destination": "/api/admin/health?action=assets"
    },
    {
      "source": "/api/admin/pilot-applications",
      "destination": "/api/admin/health?action=pilot-applications"
    },
    {
      "source": "/api/admin/pilot-surveys",
      "destination": "/api/admin/health?action=pilot-surveys"
    },
    {
      "source": "/api/waitlist/profile",
      "destination": "/api/waitlist?action=profile"
    },
    {
      "source": "/api/pilot-application",
      "destination": "/api/waitlist?action=pilot"
    },
    {
      "source": "/api/pilot-survey",
      "destination": "/api/waitlist?action=pilot-survey"
    },
    {
      "source": "/api/reservations/status",
      "destination": "/api/reservations?action=status"
    },
    {
      "source": "/api/reservations/checkout",
      "destination": "/api/reservations?action=checkout"
    },
    {
      "source": "/api/reservations/session",
      "destination": "/api/reservations?action=session"
    },
    {
      "source": "/setup",
      "destination": "/setup/index.html"
    },
    {
      "source": "/setup/",
      "destination": "/setup/index.html"
    }
  ],
  "headers": [
    {
      "source": "/setup/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; connect-src 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/retry-waitlist",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/refund-reservations",
      "schedule": "0 3 * * *"
    }
  ]
}
