DATABASE_URL="postgres://..."
ADMIN_PASSWORD="replace-with-a-long-random-admin-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Optional: only needed when new waitlist submissions should email an operator.
RESEND_API_KEY=""
NOTIFY_TO_EMAIL="you@example.com"
NOTIFY_FROM_EMAIL="HarborNavi <waitlist@harbornavi.com>"

# Optional: best-effort marketing contact sync after the database save succeeds.
# Create the topics in Resend first, then paste their IDs here. The site never creates topics or sends broadcasts.
RESEND_KICKSTARTER_TOPIC_ID=""
RESEND_ROAD_TOPIC_ID=""

# Public campaign links. Leave empty until each official URL is ready.
PUBLIC_ROAD_HOMES_FORM_URL=""
# Set true only after provider, retention, deletion contact, and applicant rights are published.
PUBLIC_ROAD_HOMES_PRIVACY_READY="false"
PUBLIC_KICKSTARTER_PRELAUNCH_URL=""
PUBLIC_YOUTUBE_CHANNEL_URL=""
PUBLIC_YOUTUBE_PLAYLIST_URL=""
# before_prelaunch | prelaunch_live | road_live | replay
PUBLIC_CAMPAIGN_PHASE="before_prelaunch"

# Founder reservation checkout remains hidden until all Stripe values are ready.
FOUNDER_RESERVATION_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
CRON_SECRET=""
# Set this to the actual Kickstarter launch time before enabling automatic refunds.
FOUNDER_RESERVATION_REFUND_AT=""
