DATABASE_URL="postgres://..."
ADMIN_PASSWORD="replace-with-a-long-random-admin-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Optional for local or non-Vercel Blob access. Connected Vercel deployments use OIDC automatically.
BLOB_READ_WRITE_TOKEN=""

# Required for waitlist marketing-contact sync and operator notifications.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="HarborNavi <waitlist@harbornavi.com>"

# Legacy confirmation-link support only. New waitlist submissions do not require confirmation.
WAITLIST_CONFIRMATION_FROM_EMAIL="HarborNavi <waitlist@harbornavi.com>"
WAITLIST_CONFIRMATION_SECRET="replace-with-at-least-32-random-characters"
WAITLIST_PUBLIC_ORIGIN="https://harbornavi.com"

# Optional operator alert destination and reply-to for privacy/deletion requests.
NOTIFY_TO_EMAIL="you@example.com"

# Optional overrides. Without an ID, the retry job creates/fetches an opt-out Topic by this name.
RESEND_KICKSTARTER_TOPIC_ID=""
RESEND_KICKSTARTER_TOPIC_NAME="HarborNavi Kickstarter Updates"

# Required by Vercel Cron for integration retries and reservation-refund automation.
CRON_SECRET="replace-with-at-least-32-random-characters"

# Public campaign links. Leave empty until each official URL is ready.
PUBLIC_ROAD_HOMES_FORM_URL=""
# Set true only after provider, retention, deletion contact, and applicant rights are published.
PUBLIC_ROAD_HOMES_PRIVACY_READY="false"
PUBLIC_KICKSTARTER_PRELAUNCH_URL=""
PUBLIC_YOUTUBE_CHANNEL_URL=""
PUBLIC_YOUTUBE_PLAYLIST_URL=""
# before_prelaunch | prelaunch_live | road_live | replay
PUBLIC_CAMPAIGN_PHASE="before_prelaunch"

# Founder reservation checkout remains hidden until all Stripe values are ready.
FOUNDER_RESERVATION_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Set this to the actual Kickstarter launch time before enabling automatic refunds.
FOUNDER_RESERVATION_REFUND_AT=""
